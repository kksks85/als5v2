# Docker database credentials. Use a generated secret outside source control.
POSTGRES_DB=als50
POSTGRES_USER=als50
POSTGRES_PASSWORD=replace-with-a-long-unique-password
APP_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# On-prem Microsoft SQL Server alternative. Leave DATABASE_URL unset to use the
# local PostgreSQL Compose service. URL-encode the ODBC driver name.
# DATABASE_URL=mssql+pyodbc://als50_app:<password>@sqlserver.internal:1433/ALS50?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
# ARM64 hosts use the bundled FreeTDS driver instead:
# DATABASE_URL=mssql+pyodbc://als50_app:<password>@sqlserver.internal:1433/ALS50?driver=FreeTDS&tds_version=8.0

# Microsoft Entra ID server-side secret configuration.
# Register the SPA redirect URI at http://localhost:5173 before enabling SSO.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_API_SCOPE=

# UAT Active Directory login. Use LDAPS with a service bind account for profile
# lookup and configure one environment-only local Administrator break-glass login.
APP_ENV=uat
LDAP_SERVER_URI=ldaps://ad.company.internal:636
LDAP_BASE_DN=DC=company,DC=internal
LDAP_BIND_DN=CN=als50-service,OU=Service Accounts,DC=company,DC=internal
LDAP_BIND_PASSWORD=
LDAP_USER_DN_TEMPLATE={username}@{domain}
LDAP_USER_DOMAIN=company.internal
UAT_LOCAL_ADMIN_USERNAME=admin
UAT_LOCAL_ADMIN_PASSWORD=
UAT_LOCAL_ADMIN_EMAIL=admin@als50.local
