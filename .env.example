# Docker database credentials. Use a generated secret outside source control.
POSTGRES_DB=als50
POSTGRES_USER=als50
POSTGRES_PASSWORD=replace-with-a-long-unique-password
APP_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Microsoft Entra ID server-side secret configuration.
# Register the SPA redirect URI at http://localhost:5173 before enabling SSO.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_API_SCOPE=
