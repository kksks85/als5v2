# ============================================================================
# AEROFIX SECURITY CONFIGURATION
# ============================================================================
# Copy this to .env and fill in all REQUIRED values
# NEVER commit .env to version control!
#
# This file documents the security fixes applied (See SECURITY_TECHNICAL_FIXES.md)

# ============================================================================
# DATABASE CONFIGURATION (Fix #6: Secrets Management)
# ============================================================================
POSTGRES_DB=als50
POSTGRES_USER=als50
# Fix #6: Use strong generated password
POSTGRES_PASSWORD=<GENERATE-STRONG-PASSWORD>
APP_PORT=5173

# ============================================================================
# CORS CONFIGURATION (Fix #3: CSRF Protection)
# ============================================================================
# Production: Set to your actual domain
CORS_ORIGINS=https://app.example.com

# Optional: On-prem Microsoft SQL Server alternative
# Leave DATABASE_URL unset to use the local PostgreSQL Compose service
# DATABASE_URL=mssql+pyodbc://als50_app:<password>@sqlserver.internal:1433/ALS50?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# ============================================================================
# APPLICATION ENVIRONMENT (Fix #1: JWT Secret Management)
# ============================================================================
APP_ENV=production
APP_PUBLIC_URL=https://app.example.com

# Fix #1: REQUIRED - Generate strong JWT secret
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be at least 64 characters
AUTH_JWT_SECRET=<GENERATE-64-CHARACTER-SECRET>

# ============================================================================
# MICROSOFT ENTRA ID CONFIGURATION
# ============================================================================
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_API_SCOPE=

# ============================================================================
# LDAP / ACTIVE DIRECTORY CONFIGURATION (Fix #5: LDAP Injection Prevention)
# ============================================================================
# Use LDAPS (secure LDAP) with service bind account
LDAP_SERVER_URI=ldaps://ad.company.internal:636
LDAP_BASE_DN=DC=company,DC=internal
# Fix #5: Bind account password (never use admin credentials)
LDAP_BIND_DN=CN=als50-service,OU=Service Accounts,DC=company,DC=internal
LDAP_BIND_PASSWORD=<SERVICE-ACCOUNT-PASSWORD>
LDAP_USER_DN_TEMPLATE={username}@{domain}
LDAP_USER_DOMAIN=company.internal

# ============================================================================
# LOCAL ADMIN ACCOUNT (Fix #7: Remove Demo Privilege Escalation)
# ============================================================================
# Break-glass local administrator account (when directory is unavailable)
# Fix #7: REQUIRED - Use strong password
UAT_LOCAL_ADMIN_USERNAME=admin
UAT_LOCAL_ADMIN_PASSWORD=<GENERATE-STRONG-PASSWORD>
UAT_LOCAL_ADMIN_EMAIL=admin@als50.local

# Fix #7: Demo login is disabled by default (leave empty)
# To enable demo login, set a strong password. Users must provide this password.
UAT_DEMO_PASSWORD=

# ============================================================================
# SMTP CONFIGURATION
# ============================================================================
SMTP_HOST=smtp.company.com
SMTP_PORT=587
SMTP_USERNAME=noreply@company.com
# Fix #6: Use strong SMTP password
SMTP_PASSWORD=<SMTP-PASSWORD>
SMTP_FROM_EMAIL=noreply@company.com
SMTP_FROM_NAME=Aerofix Service
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ============================================================================
# SECURITY REQUIREMENTS (See SECURITY_TECHNICAL_FIXES.md)
# ============================================================================
# Fix #1: JWT Secret Management
#   - Generate strong 64+ character secret
#   - Rotate every 90 days
#   - Never use defaults in production
#
# Fix #2: Authentication on Data Endpoints
#   - All API endpoints require valid session token
#   - Token verified with server-side revocation check
#
# Fix #3: CSRF Protection
#   - All write operations (PUT, POST, DELETE) require CSRF token
#   - CSRF tokens validated for same-origin requests only
#
# Fix #5: LDAP Injection Prevention
#   - Use LDAPS (encrypted LDAP)
#   - Special characters properly escaped by library
#   - Never concatenate user input into LDAP queries
#
# Fix #6: Secrets Management
#   - All passwords/secrets moved to environment variables
#   - .env file is git-ignored
#   - Use secrets management system in production (AWS Secrets, Vault, Azure Key Vault)
#
# Fix #7: Remove Demo Privilege Escalation
#   - Demo users no longer get auto-elevated to Administrator role
#   - Demo login disabled by default (requires password)
#   - Only explicit admin users get Administrator role
#
# Fix #8: HTTPS Enforcement
#   - All HTTP traffic redirected to HTTPS
#   - HSTS header enforces HTTPS for 1 year
#   - Strict-Transport-Security with preload
#
# Fix #10: Security Headers
#   - X-Content-Type-Options: nosniff
#   - X-Frame-Options: DENY
#   - X-XSS-Protection: 1; mode=block
#   - Referrer-Policy: strict-origin-when-cross-origin
#   - Permissions-Policy: Restrict browser features
#   - Content-Security-Policy: Strict CSP

# ============================================================================
# PASSWORD GENERATION
# ============================================================================
# Generate strong passwords using:
# 
# For random secrets (64 characters):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# For random passwords (32 characters):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Or use your password manager (1Password, Bitwarden, LastPass, etc.)

# ============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================================================
# Before deploying to production:
#
# [ ] Generate all secrets using random generation (NOT defaults)
# [ ] Store .env file securely (not in version control)
# [ ] Use secrets management system (AWS Secrets, Vault, etc.)
# [ ] Enable HTTPS with valid SSL certificates
# [ ] Verify APP_ENV is set to "production"
# [ ] Configure CORS_ORIGINS to your actual domain
# [ ] Setup monitoring and logging
# [ ] Enable audit logging
# [ ] Configure automated secret rotation
# [ ] Run security tests (see SECURITY_TESTING_GUIDE.md)
# [ ] Perform penetration testing
# [ ] Setup incident response procedures
